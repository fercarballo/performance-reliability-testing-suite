# =============================================================================
# Telco Reliability Lab - Environment template
# Copy to `.env` (the docker-compose stack reads sensible defaults already).
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=local
API_PORT=3000
LOG_LEVEL=info

# --- Database (PostgreSQL) -------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=telco
POSTGRES_PASSWORD=telco
POSTGRES_DB=telco

# --- Cache (Redis) ---------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- Auth ------------------------------------------------------------------
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=3600

# --- Bootstrap -------------------------------------------------------------
# When true the API runs migrations and seeds synthetic data on startup.
SEED_ON_START=true
SEED_CUSTOMERS=100

# --- Fault injection -------------------------------------------------------
# /admin/faults is ONLY mounted when this is true. Never enable in production.
ENABLE_FAULTS=true

# --- Observability ---------------------------------------------------------
OTEL_ENABLED=true
OTEL_SERVICE_NAME=telco-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
DEPLOYMENT_ENVIRONMENT=local

# Ship structured logs to Loki (set false to log only to stdout).
LOKI_ENABLED=true
LOKI_URL=http://loki:3100
